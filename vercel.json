{
  "rewrites": [
    {
      "source": "/projects/areta",
      "destination": "/projects/areta/index.html"
    },
    {
      "source": "/projects/areta/",
      "destination": "/projects/areta/index.html"
    },
    {
      "source": "/projects/ultracamp",
      "destination": "/projects/ultracamp/index.html"
    },
    {
      "source": "/projects/ultracamp/",
      "destination": "/projects/ultracamp/index.html"
    },
    {
      "source": "/projects/festgo-app",
      "destination": "/projects/festgo-app/index.html"
    },
    {
      "source": "/projects/festgo-app/",
      "destination": "/projects/festgo-app/index.html"
    },
    {
      "source": "/projects/portfolio-25",
      "destination": "/projects/portfolio-25/index.html"
    },
    {
      "source": "/projects/portfolio-25/",
      "destination": "/projects/portfolio-25/index.html"
    },
    {
      "source": "/projects/howell-gallery",
      "destination": "/projects/howell-gallery/index.html"
    },
    {
      "source": "/projects/howell-gallery/",
      "destination": "/projects/howell-gallery/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
